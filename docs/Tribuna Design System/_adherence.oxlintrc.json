      {
        "selector": "JSXOpeningElement[name.name='TimeWarningBorder'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:none|fiveMin|oneMin)$/]",
        "message": "<TimeWarningBorder> level must be one of 'none' | 'fiveMin' | 'oneMin'."
