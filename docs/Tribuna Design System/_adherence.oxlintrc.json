{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/prompter/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Atkinson Hyperlegible Next|Bricolage Grotesque))/i]",
        "message": "Font not provided by the design system. Available: Atkinson Hyperlegible Next, Bricolage Grotesque."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onClose|children|variant|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: title, onClose, children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:sheet|panel)$/]",
        "message": "<BottomSheet> variant must be one of 'sheet' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|fullWidth|disabled|children|onClick|style|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, fullWidth, disabled, children, onClick, style, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|outlineNeutral|secondary|tonal|tonalDanger|text|textAccent|textDanger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'outlineNeutral' | 'secondary' | 'tonal' | 'tonalDanger' | 'text' | 'textAccent' | 'textDanger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md|pill)$/]",
        "message": "<Button> size must be one of 'xl' | 'lg' | 'md' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ColorButton> doesn't accept that prop. Declared props: color, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|hint|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: value, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|actions|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, children, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|key|ref|className|style|children)$/]",
        "message": "<FeatureItem> doesn't accept that prop. Declared props: icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|iconSize|strokeWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, iconSize, strokeWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outlined|tile)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outlined' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|key|ref|className|style|children)$/]",
        "message": "<InfoCard> doesn't accept that prop. Declared props: icon, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|wordmark|label|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, variant, wordmark, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mint|ink|black|white)$/]",
        "message": "<Logo> variant must be one of 'mint' | 'ink' | 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|active|style|key|ref|className|style|children)$/]",
        "message": "<MicIndicator> doesn't accept that prop. Declared props: level, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: active, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|children|action|onAction|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: icon, tone, children, action, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warning|danger)$/]",
        "message": "<Notice> tone must be one of 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PausePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<PausePill> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|variant|label|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, variant, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:setup|thin)$/]",
        "message": "<ProgressBar> variant must be one of 'setup' | 'thin'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptText'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|cursor|fontSize|lineHeight|weight|margin|color|highlight|readOpacity|fontFamily|onWordClick|style|key|ref|className|style|children)$/]",
        "message": "<PromptText> doesn't accept that prop. Declared props: text, cursor, fontSize, lineHeight, weight, margin, color, highlight, readOpacity, fontFamily, onWordClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadingIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:top|variant|color|lineHeight|key|ref|className|style|children)$/]",
        "message": "<ReadingIndicator> doesn't accept that prop. Declared props: top, variant, color, lineHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadingIndicator'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:arrow|band|none)$/]",
        "message": "<ReadingIndicator> variant must be one of 'arrow' | 'band' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|disabled|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: value, label, icon, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|control|stacked|last|children|onClick|key|ref|className|style|children)$/]",
        "message": "<SettingsRow> doesn't accept that prop. Declared props: label, description, control, stacked, last, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|first|key|ref|className|style|children)$/]",
        "message": "<SettingsSection> doesn't accept that prop. Declared props: title, children, first."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|display|onChange|variant|id|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, step, display, onChange, variant, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:settings|sheet)$/]",
        "message": "<Slider> variant must be one of 'settings' | 'sheet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeedIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:speed|style|key|ref|className|style|children)$/]",
        "message": "<SpeedIndicator> doesn't accept that prop. Declared props: speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onDecrement|onIncrement|decLabel|incLabel|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, onDecrement, onIncrement, decLabel, incLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|id|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, id, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|label|style|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: value, onChange, placeholder, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeSwatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:bg|fg|label|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<ThemeSwatch> doesn't accept that prop. Declared props: bg, fg, label, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:elapsed|remaining|warning|inset|key|ref|className|style|children)$/]",
        "message": "<TimerBar> doesn't accept that prop. Declared props: elapsed, remaining, warning, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerBar'] > JSXAttribute[name.name='warning'] > Literal[value!=/^(?:none|fiveMin|oneMin)$/]",
        "message": "<TimerBar> warning must be one of 'none' | 'fiveMin' | 'oneMin'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeWarningBorder'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|key|ref|className|style|children)$/]",
        "message": "<TimeWarningBorder> doesn't accept that prop. Declared props: level."
